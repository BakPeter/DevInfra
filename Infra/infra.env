# Mount folder
MOUNT_DATA=C:\Mounts\Infra

# Host-run defaults #
# The values below are NOT used by docker compose - the compose file injects
# in-container addresses instead (seq, postgres, kafka-broker:29092).
# They only apply when a service is run directly on the host (npm start / python app.py).
SEQ_SERVER_URL=http://localhost:5341
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
# Cannot be pinned: the minio/minio Docker Hub repo is no longer pullable
# (not even :latest), so this relies on the locally cached image.
MINIO_IMG_TAG=latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Seq
SEQ_IMG_TAG=2026.1
SEQ_PORT=5341
SEQ_FIRSTRUN_ADMINPASSWORD=adminseq

# ELK
ELK_IMG_TAG=9.4.4

# Postgres
POSTGRES_IMG_TAG=18-alpine
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devinfra
# In-container host=postgres, port=5432
POSTGRES_SCHEMA_PYTHON_SERVICE=python
POSTGRES_SCHEMA_NODEJS_SERVICE=nodejs
POSTGRES_SCHEMA_DOTNET_SERVICE=dotnet

# pgAdmin
PGADMIN_IMG_TAG=latest
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@devinfra.com
PGADMIN_DEFAULT_PASSWORD=adminpgadmin

# Kafka
KAFKA_IMG_TAG=7.6.13
KAFKA_IP=localhost
KAFKA_UI_IMG_TAG=v0.7.2
KAFKA_UI_PORT=8080
KAFKA_TOPIC_ITEMS=items.events
# Exposed IP, port=9092

# Python service
PYTHON_SERVICE_REST_PORT=3002
KAFKA_TOPIC_ITEMS_PYTHON_SERVICE=${KAFKA_TOPIC_ITEMS}.python
KAFKA_TOPIC_STATE_PYTHON_SERVICE=service-python.state
PYTHON_SERVICE_STATE_INTERVAL_SECONDS=30

# Node.js service
NODEJS_SERVICE_REST_PORT=3001
KAFKA_TOPIC_ITEMS_NODEJS_SERVICE=${KAFKA_TOPIC_ITEMS}.nodejs
KAFKA_CONSUMER_GROUP_ID=service-nodejs-consumer
NODEJS_SERVICE_KAFKA_CONSUMER_TOPICS=${KAFKA_TOPIC_ITEMS_PYTHON_SERVICE}
KAFKA_TOPIC_STATE_NODEJS_SERVICE=service-nodejs.state
NODEJS_SERVICE_STATE_INTERVAL_SECONDS=30

# .NET service
DOTNET_SERVICE_REST_PORT=3003
KAFKA_TOPIC_STATE_DOTNET_SERVICE=service-dotnet.state
DOTNET_SERVICE_STATE_INTERVAL_SECONDS=30
